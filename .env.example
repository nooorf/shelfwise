# Copy to .env and adjust. Every variable is optional; these are the defaults.
# Profile: mac | cuda | cpu (selects model sizes and runtimes)
SHELFWISE_PROFILE=mac
SHELFWISE_DATABASE_URL=postgresql://shelfwise:shelfwise@localhost:5432/shelfwise
SHELFWISE_REDIS_URL=redis://localhost:6379/0
SHELFWISE_OLLAMA_URL=http://localhost:11434
# Local LLM: qwen3:4b on an 8 GB Mac, qwen3:8b or qwen3:14b on a 24 GB GPU
SHELFWISE_LLM_MODEL=qwen3:4b
# Embedding model: minilm | bge-base | qwen3-0.6b
SHELFWISE_EMBEDDING_MODEL=bge-base
SHELFWISE_LOG_LEVEL=INFO
SHELFWISE_LOG_JSON=false
