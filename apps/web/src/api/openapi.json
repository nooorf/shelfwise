            "title": "Call Number"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "due_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Due Date"
          }
        },
        "type": "object",
        "required": [
          "branch",
          "floor",
          "call_number",
          "status",
          "due_date"
        ],
        "title": "CopyInfo"
