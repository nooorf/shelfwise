    "/api/v1/sessions/{session_id}/surprise": {
      "post": {
        "summary": "Surprise",
        "description": "The \"Surprise me\" button: three unseen books on the shelf now, within the hard\nchips. No parsing.",
        "operationId": "surprise_api_v1_sessions__session_id__surprise_post",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Session Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SurpriseRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
