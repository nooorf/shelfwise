        }
      }
    },
    "/api/v1/sessions/{session_id}": {
      "delete": {
        "summary": "End Session",
        "description": "\"New visitor\" / forget me: the state is deleted now, not at expiry.",
        "operationId": "end_session_api_v1_sessions__session_id__delete",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Session Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
