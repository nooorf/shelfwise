  "components": {
    "schemas": {
      "Availability": {
        "properties": {
          "state": {
            "$ref": "#/components/schemas/AvailabilityState"
          },
          "available_copies": {
            "type": "integer",
            "title": "Available Copies"
          },
          "total_copies": {
            "type": "integer",
            "title": "Total Copies"
          },
          "next_due": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Due"
          },
          "location": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Location"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "state",
          "available_copies",
          "total_copies",
          "next_due",
          "location"
        ],
        "title": "Availability"
      },
      "AvailabilityState": {
        "type": "string",
        "enum": [
          "available",
          "in_library_only",
          "due_soon",
          "borrowed",
          "unavailable"
        ],
        "title": "AvailabilityState"
      },
      "BookDetail": {
        "properties": {
          "work_id": {
            "type": "integer",
            "title": "Work Id"
          },
          "work_key": {
            "type": "string",
            "title": "Work Key"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "subtitle": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Subtitle"
          },
          "authors": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Authors"
          },
          "year": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Year"
          },
          "pages": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pages"
          },
          "genres": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Genres"
          },
          "availability": {
            "$ref": "#/components/schemas/Availability"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "tags": {
            "additionalProperties": true,
            "type": "object",
            "title": "Tags"
          },
          "editions": {
            "items": {
              "$ref": "#/components/schemas/EditionInfo"
            },
            "type": "array",
            "title": "Editions"
          },
          "copies": {
            "items": {
              "$ref": "#/components/schemas/CopyInfo"
            },
            "type": "array",
            "title": "Copies"
          }
        },
        "type": "object",
        "required": [
          "work_id",
          "work_key",
          "title",
          "subtitle",
          "authors",
          "year",
          "pages",
          "genres",
          "availability",
          "description",
          "tags",
          "editions",
          "copies"
        ],
        "title": "BookDetail",
        "description": "Everything the book drawer shows: the card's facts plus the record behind them."
      },
      "BookFeedback": {
        "properties": {
          "work_id": {
            "type": "integer",
            "title": "Work Id"
          },
          "more": {
            "type": "boolean",
            "title": "More"
          },
          "limit": {
            "type": "integer",
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Limit",
            "default": 5
          },
          "narrate": {
            "type": "boolean",
            "title": "Narrate",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "work_id",
          "more"
        ],
        "title": "BookFeedback",
        "description": "\"More like this\" / \"less like this\" on a shown book."
      },
      "BookResult": {
        "properties": {
          "work_id": {
            "type": "integer",
            "title": "Work Id"
          },
          "work_key": {
            "type": "string",
            "title": "Work Key"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "subtitle": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Subtitle"
          },
          "authors": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Authors"
          },
          "year": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Year"
          },
          "pages": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pages"
          },
          "genres": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Genres"
          },
          "availability": {
            "$ref": "#/components/schemas/Availability"
          }
        },
        "type": "object",
        "required": [
          "work_id",
          "work_key",
          "title",
          "subtitle",
          "authors",
          "year",
          "pages",
          "genres",
          "availability"
        ],
        "title": "BookResult"
      },
      "Chip": {
        "properties": {
          "label": {
            "type": "string",
            "title": "Label"
          },
          "field": {
            "type": "string",
            "title": "Field"
          },
          "op": {
            "type": "string",
            "title": "Op"
          },
          "value": {
            "title": "Value"
          },
          "strength": {
            "type": "string",
            "title": "Strength"
          },
          "polarity": {
            "type": "string",
            "title": "Polarity"
          },
          "turn": {
            "type": "integer",
            "title": "Turn"
          },
          "switchable": {
            "type": "boolean",
            "title": "Switchable",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "label",
          "field",
          "op",
          "value",
          "strength",
          "polarity",
          "turn"
        ],
        "title": "Chip",
        "description": "An active constraint as the UI shows it; removable by naming its field and label.\n`switchable`: it means something both as a must (filter) and as a preference (nudge), so\nthe reader may switch it; \"available now\" only filters and themes only nudge."
      },
      "ChipRemoval": {
        "properties": {
          "field": {
            "type": "string",
            "title": "Field"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "limit": {
            "type": "integer",
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Limit",
            "default": 5
          },
          "narrate": {
            "type": "boolean",
            "title": "Narrate",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "field",
          "label"
        ],
        "title": "ChipRemoval",
        "description": "The chip to take away, as the response showed it: its field and label."
      },
      "ChipStrength": {
        "properties": {
          "field": {
            "type": "string",
            "title": "Field"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "strength": {
            "type": "string",
            "enum": [
              "hard",
              "soft"
            ],
            "title": "Strength"
          },
          "limit": {
            "type": "integer",
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Limit",
            "default": 5
          },
          "narrate": {
            "type": "boolean",
            "title": "Narrate",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "field",
          "label",
          "strength"
        ],
        "title": "ChipStrength",
        "description": "Switch a chip to must (\"hard\") or preferred (\"soft\"), named as the response showed it."
      },
      "CopyInfo": {
        "properties": {
          "branch": {
            "type": "string",
            "title": "Branch"
          },
          "floor": {
            "anyOf": [
