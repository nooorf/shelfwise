    "/api/v1/sessions/{session_id}/feedback": {
      "post": {
        "summary": "Book Feedback",
        "description": "\"More like this\" (the book becomes the seed) or \"less like this\" (it is hidden and\nthe books nearest it pushed down) on a shown book; the search runs again.",
        "operationId": "book_feedback_api_v1_sessions__session_id__feedback_post",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Session Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BookFeedback"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
